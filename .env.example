# KaSpot Environment Configuration Template
# Copy this file to .env and configure your Supabase project keys:
# cp .env.example .env

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Development-only local preview session (fabricated local user, no server
# verification). Never enable in release builds.
# KASPOT_LOCAL_PREVIEW=true
